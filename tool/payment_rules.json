{
  "PaymentMoney": "if(!RegExp(r'^[A-Z]{3}$').hasMatch(currency)||decimals>4)",
  "PaymentCurrencyRule": "if(revision<1||decimals>4||stepMinor<1||operation!='charge'||!RegExp(r'^[A-Z]{3}$').hasMatch(currency)||!expiresAt.isAfter(observedAt)||minimumMinor!=null&&maximumMinor!=null&&minimumMinor!>maximumMinor!)",
  "PaymentCurrencyCatalog": "if(revision<1||!expiresAt.isAfter(observedAt)||!RegExp(r'^[A-Z]{2}$').hasMatch(merchantCountry)||rules.map((r)=>r.currency).toSet().length!=rules.length)",
  "PaymentOrderLine": "if(quantity<1||quantity>100||!{'item','tax','fee','discount','credit'}.contains(kind))",
  "PaymentAdjustment": "if(revision<1||!{'tax','fee','discount','credit'}.contains(kind))",
  "PaymentOrder": "if(revision<1||updatedAt.isBefore(createdAt)||!{'draft','quoted','paymentPending','paid','cancelled','unknown'}.contains(status)||lines.map((l)=>l.id).toSet().length!=lines.length||adjustments.map((a)=>a.id).toSet().length!=adjustments.length)",
  "PaymentQuote": "if(revision<1||orderRevision<1||!expiresAt.isAfter(observedAt))",
  "PaymentCustomerReference": "if(revision<1||!expiresAt.isAfter(observedAt)||!{'test','live'}.contains(environment))",
  "PaymentBillingSummary": "if(revision<1||!{'sdk','backend','unknown'}.contains(source)||countryCode!=null&&!RegExp(r'^[A-Z]{2}$').hasMatch(countryCode!))",
  "PaymentMethodReference": "if(!expiresAt.isAfter(observedAt)||last4!=null&&!RegExp(r'^\\d{4}$').hasMatch(last4!)||expiryMonth!=null&&(expiryMonth!<1||expiryMonth!>12)||!{'test','live'}.contains(environment))",
  "PaymentWalletCapability": "if(!{'applePay','googlePay','card'}.contains(kind)||!expiresAt.isAfter(checkedAt)||!{'test','live'}.contains(environment))",
  "PaymentSdkConfiguration": "if(version!=1||!RegExp(r'^[A-Z]{2}$').hasMatch(merchantCountry)||!{'test','live'}.contains(environment)||!{'automatic','required','never'}.contains(billingCollection))",
  "PaymentCredentialsReference": "if(revision<1||!expiresAt.isAfter(createdAt)||!{'test','live'}.contains(environment))",
  "PaymentCheckoutRequest": "if(revision<1||orderRevision<1||!{'test','live'}.contains(environment)||idempotencyKey.length>200)",
  "PaymentAllocation": "if(revision<1||!expiresAt.isAfter(observedAt)||!{'test','live'}.contains(environment))",
  "PaymentAttempt": "if(revision<1||updatedAt.isBefore(createdAt)||!{'created','allocating','allocated','presenting','verifying','pending','completed','cancelled','failed','uncertain'}.contains(state))",
  "PaymentIntent": "if(revision<1||orderRevision<1||!expiresAt.isAfter(observedAt)||!{'test','live'}.contains(environment))",
  "PaymentVerificationRequest": "if(minimumRevision<1||!{'test','live'}.contains(environment))",
  "PaymentWebhookAcknowledgement": "if(revision<1||verifiedAt.isBefore(receivedAt))",
  "PaymentOrderBinding": "if(orderRevision<1||!expiresAt.isAfter(observedAt)||!{'test','live'}.contains(environment))",
  "PaymentVerification": "if(revision<1||!expiresAt.isAfter(observedAt))",
  "PaymentNextAction": "if(revision<1||!expiresAt.isAfter(observedAt)||!{'authenticate','awaitProcessing','provideMethod','confirm','none','unknown'}.contains(kind))",
  "PaymentReturnPolicy": "if(version!=1||allowedSchemes.any((s)=>!{'https','mytrippl'}.contains(s)))",
  "PaymentReturnSignal": "if(paymentConfirmed||!{'successMarker','cancelMarker','unknown'}.contains(kind))",
  "PaymentError": "if(!RegExp(r'^[A-Za-z0-9_-]{1,80}$').hasMatch(code)||declineCode!=null&&!RegExp(r'^[A-Za-z0-9_-]{1,80}$').hasMatch(declineCode!))",
  "PaymentRetryPolicy": "if(version!=1||maximumReadAttempts<1||maximumReadAttempts>3||initialDelaySeconds<1||maximumDelaySeconds<initialDelaySeconds||maximumDelaySeconds>120||allowMutationRetry)",
  "PaymentReadPolicy": "if(version!=1||timeoutSeconds<1||timeoutSeconds>120||maximumInflight<1||maximumInflight>8||maximumAgeSeconds<1||maximumAgeSeconds>3600||maximumPages<1||maximumPages>20||maximumRecords<1||maximumRecords>100)",
  "PaymentReadRequest": "if(!{'intent','methods','receipt','currencies','refunds'}.contains(mode)||!{'test','live'}.contains(environment)||limit<1||limit>100)",
  "PaymentReadPage": "if(!expiresAt.isAfter(observedAt)||complete&&cursor!=null||!{'test','live'}.contains(environment))",
  "PaymentReadFailure": "if(operation!='read'||!RegExp(r'^[A-Za-z0-9_-]{1,80}$').hasMatch(code)||retryAfterSeconds!=null&&retryAfterSeconds!>120)",
  "PaymentReadState": "if(generation<1||attempt<1||attempt>3||!{'loading','ready','failed','cancelled'}.contains(state)||state=='ready'&&page==null||state=='failed'&&failure==null)",
  "PaymentCheckoutState": "if(revision<1||!{'idle','preparing','ready','presenting','verifying','paid','pending','authorized','cancelled','failed','uncertain'}.contains(state))",
  "PaymentCheckoutResult": "if(paid&&!serverVerified||bookingConfirmed&&!paid)",
  "PaymentReceiptLine": "if(quantity<1||quantity>100||!{'item','tax','fee','discount','credit'}.contains(kind))",
  "PaymentReceipt": "if(revision<1||!expiresAt.isAfter(observedAt)||issuedAt.isAfter(observedAt)||!{'test','live'}.contains(environment))",
  "PaymentRefundReference": "if(revision<1||!expiresAt.isAfter(observedAt)||!{'pending','requires_action','succeeded','failed','canceled','unknown'}.contains(status)||!{'test','live'}.contains(environment))"
}

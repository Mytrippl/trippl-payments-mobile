{
  "PaymentMoney": "if(!RegExp(r'^[A-Z]{3}$').hasMatch(currency)||decimals>4)",
  "PaymentCurrencyRule": "if(revision<1||decimals>4||stepMinor<1||operation!='charge'||!RegExp(r'^[A-Z]{3}$').hasMatch(currency)||!expiresAt.isAfter(observedAt)||minimumMinor!=null&&maximumMinor!=null&&minimumMinor!>maximumMinor!)",
  "PaymentCurrencyCatalog": "if(revision<1||!expiresAt.isAfter(observedAt)||!RegExp(r'^[A-Z]{2}$').hasMatch(merchantCountry)||rules.map((r)=>r.currency).toSet().length!=rules.length)",
  "PaymentOrderLine": "if(quantity<1||quantity>100||!{'item','tax','fee','discount','credit'}.contains(kind))",
  "PaymentAdjustment": "if(revision<1||!{'tax','fee','discount','credit'}.contains(kind))",
  "PaymentOrder": "if(revision<1||updatedAt.isBefore(createdAt)||!{'draft','quoted','paymentPending','paid','cancelled','unknown'}.contains(status)||lines.map((l)=>l.id).toSet().length!=lines.length||adjustments.map((a)=>a.id).toSet().length!=adjustments.length)",
  "PaymentQuote": "if(revision<1||orderRevision<1||!expiresAt.isAfter(observedAt))",
  "PaymentCustomerReference": "if(revision<1||!expiresAt.isAfter(observedAt)||!{'test','live'}.contains(environment))",
  "PaymentBillingSummary": "if(revision<1||!{'sdk','backend','unknown'}.contains(source)||countryCode!=null&&!RegExp(r'^[A-Z]{2}$').hasMatch(countryCode!))",
  "PaymentMethodReference": "if(!expiresAt.isAfter(observedAt)||last4!=null&&!RegExp(r'^\\d{4}$').hasMatch(last4!)||expiryMonth!=null&&(expiryMonth!<1||expiryMonth!>12)||!{'test','live'}.contains(environment))"
}
